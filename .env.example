# nethub 环境变量示例 (复制为 .env 或直接在 docker-compose 配置)
# 数据目录 (默认 ./data)
#DATA_DIR=./data

# 扫描的网段 (CIDR)
SCAN_SUBNET=192.168.1.0/24

# 子网扫描的常见端口列表 (逗号分隔)
SCAN_PORTS=80,443,3000,3001,4000,5000,66,8000,8010,8090,8092,8322,8080,8088,8081,9000,8888,9090,9443

# 是否对本机 IP 全端口(1-65535)扫描 (1=是)
SCAN_FULL_PORTS=1

# 自动重扫间隔 (小时)
SCAN_INTERVAL_HOURS=6

# 本服务监听端口 (扫描时排除自身)
OWN_PORT=80

# 端口连接/HTTP 探测超时 (秒)
CONNECT_TIMEOUT=0.4
HTTP_TIMEOUT=2.5
