# nethub 环境变量示例 (复制为 .env 或直接在 docker-compose 配置)
# 数据目录 (默认 ./data)
#DATA_DIR=./data

# 扫描的网段 (CIDR)
SCAN_SUBNET=192.168.1.0/24

# 探活端口列表 (逗号分隔): 用于快速发现在线主机; 不在列表的端口由
# 全端口扫描(SCAN_FULL_PORTS=1)对每台在线主机兜底, 即最终覆盖 1-65535 全部端口
SCAN_PORTS=80,443,22,5000,5001,66,3000,3001,3002,4000,5601,7000,7001,7443,8000,8010,8080,8081,8085,8088,8090,8092,8181,8322,8443,8800,8880,8888,9000,9001,9080,9090,9443,4848,5050,8091,8082,8282,10000

# 是否对每台在线主机做全端口(1-65535)扫描 (1=是; 需几分钟)
SCAN_FULL_PORTS=1

# 自动重扫间隔 (小时)
SCAN_INTERVAL_HOURS=6

# 本服务监听端口 (扫描时排除自身)
OWN_PORT=80

# 端口连接/HTTP 探测超时 (秒)
CONNECT_TIMEOUT=0.4
HTTP_TIMEOUT=2.5
